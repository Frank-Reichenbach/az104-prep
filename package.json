{
  "name": "az-104-study",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local AZ-104 knowledge base and multiple-choice practice",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "pnpm run build:css && node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test",
    "build:site": "pnpm run check && node scripts/build-site.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "build:css": "tailwindcss -i app/tailwind.css -o app/style.css --minify",
    "dev:css": "tailwindcss -i app/tailwind.css -o app/style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
